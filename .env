# Every image/version pin lives here. Upgrades are one-line changes.
STACK_VERSION=8.14.2
COLLECTOR_VERSION=0.145.0

# Elasticsearch JVM heap. Explicit, because the default sizing thrashes on
# Docker Desktop. Requires at least 4 GiB allocated to Docker Desktop.
ES_JAVA_HEAP=1g

ES_PORT=9200
KIBANA_PORT=5601
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
COLLECTOR_METRICS_PORT=8888
