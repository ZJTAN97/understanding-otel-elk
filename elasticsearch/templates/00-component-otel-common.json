{
  "_meta": {
    "note": "OTel-mode document shape. ES 8.16+ ships equivalent templates via otel-data; on 8.14.2 we own them."
  },
  "template": {
    "settings": {
      "index.number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date_nanos"
        },
        "observed_timestamp": {
          "type": "date_nanos"
        },
        "trace_id": {
          "type": "keyword"
        },
        "span_id": {
          "type": "keyword"
        },
        "dropped_attributes_count": {
          "type": "long"
        },
        "attributes": {
          "type": "object",
          "dynamic": true,
          "subobjects": false
        },
        "resource": {
          "properties": {
            "schema_url": {
              "type": "keyword"
            },
            "attributes": {
              "type": "object",
              "dynamic": true,
              "subobjects": false
            },
            "dropped_attributes_count": {
              "type": "long"
            }
          }
        },
        "scope": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            },
            "schema_url": {
              "type": "keyword"
            },
            "attributes": {
              "type": "object",
              "dynamic": true,
              "subobjects": false
            },
            "dropped_attributes_count": {
              "type": "long"
            }
          }
        }
      },
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "path_match": [
              "attributes.*",
              "resource.attributes.*",
              "scope.attributes.*",
              "body.structured.*"
            ],
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ]
    }
  }
}