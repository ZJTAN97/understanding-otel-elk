{
  "index_patterns": ["traces-*.otel-*"],
  "priority": 200,
  "data_stream": {},
  "composed_of": ["otel-common@mappings"],
  "template": {
    "mappings": {
      "properties": {
        "parent_span_id":  { "type": "keyword" },
        "trace_state":     { "type": "keyword" },
        "name":            { "type": "keyword" },
        "kind":            { "type": "keyword" },
        "duration":        { "type": "long" },
        "status": {
          "properties": {
            "code":    { "type": "keyword" },
            "message": { "type": "match_only_text" }
          }
        },
        "links": {
          "type": "object",
          "properties": {
            "trace_id":    { "type": "keyword" },
            "span_id":     { "type": "keyword" },
            "trace_state": { "type": "keyword" },
            "attributes":  { "type": "object", "dynamic": true, "subobjects": false }
          }
        },
        "events": {
          "type": "nested",
          "properties": {
            "@timestamp": { "type": "date_nanos" },
            "name":       { "type": "keyword" },
            "attributes": { "type": "object", "dynamic": true, "subobjects": false }
          }
        }
      }
    }
  }
}
