{
  "index_patterns": ["logs-*.otel-*"],
  "priority": 200,
  "data_stream": {},
  "composed_of": ["otel-common@mappings"],
  "template": {
    "mappings": {
      "properties": {
        "severity_text":   { "type": "keyword" },
        "severity_number": { "type": "byte" },
        "event_name":      { "type": "keyword" },
        "trace_flags":     { "type": "long" },
        "body": {
          "properties": {
            "text":       { "type": "match_only_text" },
            "structured": { "type": "object", "dynamic": true, "subobjects": false }
          }
        }
      }
    }
  }
}
